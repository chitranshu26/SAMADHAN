# Copy to .env.local. Never commit credentials.
APP_URL=http://127.0.0.1:3000
DEMO_MODE=true
# Leave empty for persistent embedded local PostgreSQL.
DATABASE_URL=
PGLITE_DATA_DIR=.data/postgres
SESSION_SECRET=
SCHEDULER_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SAMADHAN Notification Bot <demo@samadhan.local>
SMTP_TEST_RECIPIENT=
# Real mail requires a verified sender domain and SMTP configuration.
ALLOW_REAL_EMAIL=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional OpenAI-compatible inference. Configure all three values to enable
# opt-in AI assistance; complaint text is sent to this provider only on request.
# OpenAI API Configuration
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_MODEL=
AI_MODEL=
